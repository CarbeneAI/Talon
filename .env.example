# Optional SSH reference values
# Talon does not load this file or consume these variables.
# Use them only if your reviewed SSH MCP provider documents support.
# Otherwise configure the provider using its own documented settings.
# NEVER commit .env to version control

# Your Kali Linux (or pentest VM) IP address
SSH_HOST=YOUR_KALI_IP

# SSH username on the pentest VM
SSH_USER=YOUR_USERNAME

# Example private-key path; the provider determines path expansion and defaults
SSH_KEY_PATH=~/.ssh/id_ed25519
